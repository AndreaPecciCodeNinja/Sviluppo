# Meta WhatsApp Business Cloud API
# Copy to .env.local and fill in values from Meta Developer Console.
# Never commit real secrets.

# Permanent / system-user token with whatsapp_business_messaging
WHATSAPP_ACCESS_TOKEN=

# Phone number ID from WhatsApp > API setup
WHATSAPP_PHONE_NUMBER_ID=

# WhatsApp Business Account (WABA) ID — useful for ops / debugging
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Arbitrary string you choose; must match Meta webhook "Verify token"
WHATSAPP_WEBHOOK_VERIFY_TOKEN=change-me-to-a-long-random-string

# App secret from Meta App Dashboard > Settings > Basic (for X-Hub-Signature-256)
WHATSAPP_APP_SECRET=

# Graph API version (optional)
META_GRAPH_API_VERSION=v21.0

# Inbox UI poll interval in ms (optional)
NEXT_PUBLIC_POLL_INTERVAL_MS=3000
