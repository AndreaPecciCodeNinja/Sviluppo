# Bird WhatsApp inbox — local development
# Copy to .env.local and fill in values from the Bird dashboard.
# Never commit real secrets.

# Workspace API key (bk_{region}_…). Create under:
# Bird dashboard → Platform tools → API keys
# Required scopes: whatsapp (write). Optional: webhooks (write) if you register a webhook.
BIRD_API_KEY=

# Optional. Derived from the key prefix when omitted
# (bk_us1_… → https://us1.platform.bird.com, bk_eu1_… → https://eu1.platform.bird.com).
BIRD_API_BASE_URL=https://us1.platform.bird.com

# Existing CodeNinja WhatsApp number already connected in Bird
BIRD_WHATSAPP_PHONE_NUMBER=+393337802795
BIRD_WHATSAPP_NUMBER_ID=wan_01m5n2ffp9e019bnda2e60s4z9

# Optional. Workspace keys already bind a workspace; set only for master keys / debugging.
# BIRD_WORKSPACE_ID=ws_…

# Optional. Signing secret from Bird webhook create/rotate (whsec_…).
# Leave empty to skip signature checks in local scaffold only.
BIRD_WEBHOOK_SECRET=

# Inbox UI poll interval (ms). Scaffold uses polling; webhook is optional.
NEXT_PUBLIC_POLL_INTERVAL_MS=3000

# OpenAI Whisper — required only to transcribe inbound voice notes / audio
# when you click them in the thread. Never commit real keys.
OPENAI_API_KEY=

# Optional Whisper overrides (defaults shown)
OPENAI_TRANSCRIBE_MODEL=whisper-1
OPENAI_TRANSCRIBE_LANGUAGE=it

# Reply agent provider: ollama | claude (default: ollama for local Mac/dev)
REPLY_PROVIDER=ollama

# --- Claude (when REPLY_PROVIDER=claude) ---
# Never commit real keys.
ANTHROPIC_API_KEY=
# Default: claude-haiku-4-5 (Haiku 4.5 — fast/cheap routing).
ANTHROPIC_MODEL=claude-haiku-4-5

# --- Ollama local (when REPLY_PROVIDER=ollama) ---
# Run on the same machine as Next.js. No API key required.
#   ollama pull qwen2.5:7b
#   ollama serve   # if not already running as a service
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# Local chat memory (LangChain-compatible history + facts) — SQLite, no cloud keys
# Default path is gitignored under .data/
MEMORY_SQLITE_PATH=.data/memory.sqlite
# How many recent snippets to inject into reply-agent prompts
MEMORY_MAX_MESSAGES=20
