# WhatsApp Web session (Baileys) — local development
# Copy to .env.local for Next.js and/or export in your shell for the WA server.
# No Meta Cloud API tokens. Session files are created after you scan the QR.

# Express WA session server (default 3001, bound to 127.0.0.1)
WA_SERVER_PORT=3001

# Where Next.js rewrites /api/* (must match the server above)
WA_SERVER_URL=http://127.0.0.1:3001

# Multi-file Baileys auth (gitignored)
WA_AUTH_DIR=.data/wa-auth

# Inbox JSON cache (gitignored)
WA_STORE_PATH=.data/store.json

# Baileys log level: fatal|error|warn|info|debug|trace
WA_LOG_LEVEL=warn

# Inbox UI poll interval (ms)
NEXT_PUBLIC_POLL_INTERVAL_MS=2500
