{
  "name": "whatsapp-web-session-inbox",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n wa,web -c green,cyan \"npm run dev:wa\" \"npm run dev:web\"",
    "dev:wa": "tsx server/index.ts",
    "dev:web": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "concurrently -k -n wa,web -c green,cyan \"npm run start:wa\" \"npm run start:web\"",
    "start:wa": "tsx server/index.ts",
    "start:web": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@whiskeysockets/baileys": "^6.7.18",
    "cors": "^2.8.5",
    "dotenv": "^18.0.10",
    "express": "^4.21.2",
    "next": "15.5.29",
    "pino": "^9.6.0",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.1.2",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "tsx": "^4.19.3",
    "typescript": "^5"
  }
}
